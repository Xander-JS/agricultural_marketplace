# Copia este archivo a `.env` y completa tus valores reales.
# No publiques el archivo `.env` ni compartas sus credenciales.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_publica_de_supabase

# Clave de DeepSeek para la extracción de datos de la publicación por voz.
# Obténla en https://platform.deepseek.com/api_keys (empieza por "sk-").
# En producción no expongas esta clave dentro de la app: muévela a un backend.
AI_API_KEY=

# Opcionales: por defecto se usa DeepSeek. Cambia estos valores solo si usas
# otro proveedor compatible con OpenAI Chat Completions.
# AI_ENDPOINT=https://api.deepseek.com/chat/completions
# AI_MODEL=deepseek-chat
