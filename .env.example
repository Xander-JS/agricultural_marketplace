# Copia este archivo a `.env` y completa tus valores reales.
# No publiques el archivo `.env` ni compartas sus credenciales.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_publica_de_supabase

# Clave para la extracción de datos de la publicación por voz.
# Usa una clave compatible con OpenAI Chat Completions.
# En producción no expongas esta clave dentro de la app: muévela a un backend.
AI_API_KEY=
